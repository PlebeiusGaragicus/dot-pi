#!/usr/bin/env bash
set -euo pipefail

REPO_URL="https://github.com/PlebeiusGaragicus/dot-pi.git"
DOT_PI_HOME="${DOT_PI_HOME:-$HOME/.dot-pi}"
FORCE_REBASE=false

# ── helpers ───────────────────────────────────────────────────────────────────

bold()  { printf '\033[1m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
yellow(){ printf '\033[33m%s\033[0m' "$*"; }
red()   { printf '\033[31m%s\033[0m' "$*"; }

info()  { echo "  $(green "✓") $*"; }
warn()  { echo "  $(yellow "!") $*"; }
fail()  { echo "  $(red "✗") $*"; exit 1; }

confirm() {
  local prompt="$1" default="${2:-Y}"
  local yn
  if [ "$default" = "Y" ]; then
    read -r -p "  $prompt [Y/n] " yn
    [[ "${yn:-Y}" =~ ^[Yy]$ ]]
  else
    read -r -p "  $prompt [y/N] " yn
    [[ "${yn:-N}" =~ ^[Yy]$ ]]
  fi
}

shell_rc() {
  local sh
  sh="$(basename "${SHELL:-/bin/bash}")"
  case "$sh" in
    zsh)  echo "$HOME/.zshrc" ;;
    bash) echo "$HOME/.bashrc" ;;
    *)    echo "$HOME/.${sh}rc" ;;
  esac
}

usage() {
  cat <<EOF
dot-pi installer

Usage:
  install                   Install dot-pi to $DOT_PI_HOME
  install --force-rebase    Update an existing install (stash, rebase, pop)
  install --uninstall       Remove dot-pi and clean up shell config
  install --help            Show this help

Environment:
  DOT_PI_HOME   Override install location (default: ~/.dot-pi)

One-liner:
  bash -c "\$(curl -fsSL https://raw.githubusercontent.com/PlebeiusGaragicus/dot-pi/main/install)"
EOF
  exit 0
}

# ── dependency checks ─────────────────────────────────────────────────────────

check_deps() {
  local missing=()
  for cmd in git curl jq; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    echo ""
    red "  Missing required tools: ${missing[*]}"; echo ""
    echo ""
    echo "  Install them first:"
    if [[ "$OSTYPE" == darwin* ]]; then
      echo "    brew install ${missing[*]}"
    else
      echo "    sudo apt install ${missing[*]}   # Debian/Ubuntu"
      echo "    sudo dnf install ${missing[*]}   # Fedora"
    fi
    exit 1
  fi
}

check_pi() {
  if command -v pi &>/dev/null; then
    info "pi found: $(command -v pi)"
    return
  fi

  warn "pi (coding agent) not found on PATH"
  echo ""
  if command -v npm &>/dev/null; then
    if confirm "  Install pi with npm now?" "Y"; then
      echo ""
      npm install -g @mariozechner/pi-coding-agent || {
        fail "npm install failed. Install pi manually: npm install -g @mariozechner/pi-coding-agent"
      }
      info "pi installed: $(command -v pi)"
    else
      echo ""
      warn "Skipped. Install pi before running any agent:"
      echo "    npm install -g @mariozechner/pi-coding-agent"
    fi
  else
    warn "npm not found — install Node.js first, then:"
    echo "    npm install -g @mariozechner/pi-coding-agent"
  fi
}

install_node_modules() {
  if [ ! -f "$DOT_PI_HOME/core/tests/package.json" ]; then return; fi
  if ! command -v npm &>/dev/null; then
    warn "npm not found — extension dependencies (typebox) not installed."
    echo "    Install Node.js, then run:  cd $DOT_PI_HOME/core/tests && npm install"
    return
  fi
  info "Installing extension dependencies (npm install)..."
  ( cd "$DOT_PI_HOME/core/tests" && npm install --silent ) || \
    warn "npm install failed. Run manually: cd $DOT_PI_HOME/core/tests && npm install"
}

check_espeak() {
  [[ "$OSTYPE" == darwin* ]] && return 0

  if command -v espeak-ng &>/dev/null; then
    info "espeak-ng found: $(command -v espeak-ng)"
    return 0
  fi

  warn "espeak-ng not found (used by the 'say' extension for Linux TTS)"
  echo ""

  local installer="" pkg="espeak-ng"
  if   command -v apt-get &>/dev/null; then installer="sudo apt-get install -y $pkg"
  elif command -v apt     &>/dev/null; then installer="sudo apt install -y $pkg"
  elif command -v dnf     &>/dev/null; then installer="sudo dnf install -y $pkg"
  elif command -v pacman  &>/dev/null; then installer="sudo pacman -S --noconfirm $pkg"
  fi

  if [ -n "$installer" ] && confirm "Install espeak-ng now? ($installer)" "Y"; then
    echo ""
    eval "$installer" || warn "Install failed. You can install it later: $installer"
    command -v espeak-ng &>/dev/null && info "espeak-ng installed: $(command -v espeak-ng)"
  else
    echo ""
    warn "Skipped. TTS will be unavailable until espeak-ng is installed."
    [ -n "$installer" ] && echo "    To install later: $installer"
  fi
}

# ── install ───────────────────────────────────────────────────────────────────

do_install() {
  echo ""
  echo "  $(bold "dot-pi installer")"
  echo "  ════════════════"
  echo ""
  echo "  Install location: $(bold "$DOT_PI_HOME")"
  echo ""

  check_deps
  check_pi
  check_espeak
  echo ""

  # Clone, update, or bail
  if [ -d "$DOT_PI_HOME/.git" ]; then
    if [ "$FORCE_REBASE" = true ]; then
      info "Updating dot-pi (rebase)..."
      local stashed=false
      if ! git -C "$DOT_PI_HOME" diff --quiet 2>/dev/null || \
         ! git -C "$DOT_PI_HOME" diff --cached --quiet 2>/dev/null; then
        git -C "$DOT_PI_HOME" stash push -m "dotpi-installer-autostash"
        stashed=true
      fi
      git -C "$DOT_PI_HOME" pull --rebase || {
        warn "Rebase failed — resolve conflicts in $DOT_PI_HOME and run: git rebase --continue"
        [ "$stashed" = true ] && warn "Your local changes are stashed. Run: git stash pop"
        exit 1
      }
      if [ "$stashed" = true ]; then
        git -C "$DOT_PI_HOME" stash pop || {
          warn "Stash pop had conflicts — resolve them in $DOT_PI_HOME"
        }
      fi
      info "Updated successfully"
    else
      echo ""
      info "dot-pi is already installed at $(bold "$DOT_PI_HOME")"
      echo ""
      local rc
      rc="$(shell_rc)"
      if ! grep -qF "dot-pi" "$rc" 2>/dev/null; then
        warn "Shell not configured yet. Add the following to $(bold "$rc"):"
        echo ""
        echo "$(green '# dot-pi — pi agent launcher')"
        echo "$(green "export PATH=\"\$HOME/.dot-pi/core/bin:\$PATH\"")"
        echo "$(green "source \"\$HOME/.dot-pi/env.sh\"")"
        echo ""
      fi
      echo "    To update:         $DOT_PI_HOME/install --force-rebase"
      echo "    To add providers:  dotpi setup"
      echo "    To remove:         $DOT_PI_HOME/install --uninstall"
      echo ""
      exit 0
    fi
  elif [ -d "$DOT_PI_HOME" ]; then
    fail "$DOT_PI_HOME exists but is not a git repo. Remove it first or set DOT_PI_HOME."
  else
    info "Cloning dot-pi..."
    git clone "$REPO_URL" "$DOT_PI_HOME"
  fi
  echo ""

  # Shell RC integration
  local rc
  rc="$(shell_rc)"

  # Bootstrap local-only config from examples (gitignored; safe to edit)
  if [ ! -f "$DOT_PI_HOME/shared/settings.json" ] && \
     [ -f "$DOT_PI_HOME/bootstrap/settings.json.example" ]; then
    cp "$DOT_PI_HOME/bootstrap/settings.json.example" "$DOT_PI_HOME/shared/settings.json"
    info "Created shared/settings.json from bootstrap/settings.json.example"
  fi

  if [ ! -f "$DOT_PI_HOME/shared/auth.json" ] && \
     [ -f "$DOT_PI_HOME/bootstrap/auth.json.example" ]; then
    cp "$DOT_PI_HOME/bootstrap/auth.json.example" "$DOT_PI_HOME/shared/auth.json"
    info "Created shared/auth.json from bootstrap/auth.json.example"
  fi

  if [ ! -f "$DOT_PI_HOME/model-defaults" ] && \
     [ -f "$DOT_PI_HOME/bootstrap/model-defaults.example" ]; then
    cp "$DOT_PI_HOME/bootstrap/model-defaults.example" "$DOT_PI_HOME/model-defaults"
    info "Created model-defaults from bootstrap/model-defaults.example"
  fi

  # Symlink shared/models.json to system pi config
  local pi_system_models="$HOME/.pi/agent/models.json"
  local dotpi_models="$DOT_PI_HOME/shared/models.json"
  if [ -L "$dotpi_models" ]; then
    info "shared/models.json already symlinked"
  elif [ -f "$dotpi_models" ]; then
    warn "shared/models.json is a regular file (legacy)"
    warn "Back it up and re-run, or manually: ln -sf ~/.pi/agent/models.json shared/models.json"
  elif [ -f "$pi_system_models" ]; then
    ln -sf "$pi_system_models" "$dotpi_models"
    info "Symlinked shared/models.json -> $pi_system_models"
  else
    warn "$HOME/.pi/agent/models.json not found"
    warn "Run 'pi' once or 'dotpi setup' to create it, then: dotpi sync"
  fi

  # Build bin/ symlinks
  "$DOT_PI_HOME/dotpi" sync

  # Install extension runtime dependencies (typebox, etc.)
  install_node_modules
  echo ""

  echo "  $(bold "Done!")"
  echo ""

  if grep -qF "dot-pi" "$rc" 2>/dev/null; then
    info "Shell already configured — restart your shell or run: source $rc"
  else
    echo "  Add the following to $(bold "$rc"):"
    echo ""
    echo "$(green '# dot-pi — pi agent launcher')"
    echo "$(green "export PATH=\"\$HOME/.dot-pi/core/bin:\$PATH\"")"
    echo "$(green "source \"\$HOME/.dot-pi/env.sh\"")"
    echo ""
  fi
  echo ""
  echo "  Then:"
  echo "    $(bold "dotpi setup")   Configure model providers and role assignments"
  echo "    $(bold "lm")            Start a session (use /login for first-party auth)"
  echo ""
}

# ── uninstall ─────────────────────────────────────────────────────────────────

do_uninstall() {
  echo ""
  echo "  $(bold "dot-pi uninstaller")"
  echo "  ══════════════════"
  echo ""

  if [ ! -d "$DOT_PI_HOME" ]; then
    warn "dot-pi not found at $DOT_PI_HOME — nothing to remove"
    exit 0
  fi

  echo "  This will remove: $(bold "$DOT_PI_HOME")"
  echo ""

  if ! confirm "Are you sure?" "N"; then
    echo "  Cancelled."
    exit 0
  fi
  echo ""

  # Attempt to remove dot-pi lines from shell RC
  local rc
  rc="$(shell_rc)"

  if [ -f "$rc" ] && grep -qF "dot-pi" "$rc" 2>/dev/null; then
    echo "  Removing dot-pi lines from $(bold "$rc")..."
    local tmp_rc
    tmp_rc=$(mktemp)
    grep -v "dot-pi" "$rc" > "$tmp_rc"
    if cp "$tmp_rc" "$rc" 2>/dev/null; then
      rm -f "$tmp_rc"
      info "Cleaned $rc"
    else
      rm -f "$tmp_rc"
      warn "Could not write to $rc (may need sudo)"
      echo ""
      echo "  Remove these lines manually from $(bold "$rc"):"
      echo ""
      grep -n "dot-pi" "$rc" | while IFS= read -r line; do
        echo "    $line"
      done
      echo ""
    fi
  fi

  rm -rf "$DOT_PI_HOME"
  info "Removed $DOT_PI_HOME"

  echo ""
  echo "  $(bold "dot-pi has been removed.")"
  echo "  Restart your shell to complete cleanup."
  echo ""
}

# ── main ──────────────────────────────────────────────────────────────────────

case "${1:-}" in
  --force-rebase) FORCE_REBASE=true; do_install ;;
  --uninstall)    do_uninstall ;;
  --help|-h)      usage ;;
  "")             do_install ;;
  *)              echo "Unknown option: $1"; usage ;;
esac
