.DS_Store
.env
.exa
.tavily.env
.tts-wpm
.browser-control/
model-defaults
shared/models.json
shared/settings.json
bin/
.ssh

# Agent runtime data
agents/*/sessions/*
!agents/*/sessions/.gitkeep
agents/*/auth.json
agents/*/.model
# agents/*/settings.json
agents/*/.cache/
agents/*/agents/*/.model
subagents/*/sessions/*
!subagents/*/sessions/.gitkeep
subagents/*/auth.json
subagents/*/.model
subagents/*/.cache/

# agents being developed
agents/*-beta/

# Eval results (generated per-run, can be large)
evals/results/

# Workspace MAS output (research artifacts are ephemeral)
workspaces/*
!workspaces/README.md

# Downloaded binaries (fd, rg) -- shared across MAS configs via symlinks
shared/bin/*
!shared/bin/.gitkeep

# Typecheck node_modules (devDeps for extension type-checking)
tests/node_modules/
utilities/browser-runtime/node_modules/
utilities/browser-runtime/dist/

REFERENCES/*
IGNORE/