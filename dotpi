#!/usr/bin/env bash
set -euo pipefail

DOT_PI_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
COMMANDS_DIR="$DOT_PI_DIR/core/commands"

source "$COMMANDS_DIR/_common.sh"

usage() {
  cat <<EOF
dotpi — dot-pi management CLI

Usage: dotpi <command> [args]

Commands:
  setup                                    Interactive setup wizard (API keys and models)
  model-defaults                           Configure local fallback model aliases
  create [--workspace] <mas-name>          Create a multi-agent system with an orchestrator and subagents
  create-mas [--workspace] <mas-name>      Alias for create
  create-agent [--workspace] <agent-name>  Create a standalone agent directory with a stub extension
  list                                     List existing agent configs
  link-skill <agent> <skill> [...]         Symlink one or more shared skills into an agent config
  link-auth <src> <dst>                    Override auth.json symlink (src: agent name, file path, or "shared")
  doctor [--strict]                        Run health checks on the dot-pi install
  sync                                     Rebuild bin/, bootstrap shared/auth.json if needed, link agents/*/auth.json -> shared
  version | --version | -v                 Print dotpi version (from VERSION file) and exit

Options:
  --workspace   Mark as a workspace agent. Creates a bootstrap.sh file so the
                auto-generated alias launches pi in a fresh dated directory instead of
                the user's current directory. Edit bootstrap.sh to create directories,
                export environment variables, and run preflight checks.

Examples:
  dotpi setup
  dotpi model-defaults
  dotpi create research
  dotpi create --workspace deepresearch
  dotpi create-agent twenty-questions
  dotpi create-agent --workspace my-researcher
  dotpi list
  dotpi link-skill my-agent searxng
  dotpi link-auth shared blog             # point blog at shared/auth.json (optional; dotpi sync does this by default)
EOF
  exit 1
}

[ $# -lt 1 ] && usage

cmd="$1"
shift

case "$cmd" in
  setup)        source "$COMMANDS_DIR/setup.sh" "$@" ;;
  model-defaults)
                source "$COMMANDS_DIR/model-defaults.sh" "$@" ;;
  create|create-mas)
                source "$COMMANDS_DIR/create.sh" "$@" ;;
  create-agent) source "$COMMANDS_DIR/create-agent.sh" "$@" ;;
  list)         source "$COMMANDS_DIR/list.sh" "$@" ;;
  link-skill)   source "$COMMANDS_DIR/link-skill.sh" "$@" ;;
  link-auth)    source "$COMMANDS_DIR/link-auth.sh" "$@" ;;
  doctor)       source "$COMMANDS_DIR/doctor.sh" "$@" ;;
  sync)         source "$COMMANDS_DIR/sync.sh" "$@" ;;
  version|--version|-v)
                v="unknown"
                [ -f "$DOT_PI_DIR/VERSION" ] && v="$(cat "$DOT_PI_DIR/VERSION")"
                echo "dotpi $v"
                exit 0 ;;
  --help|-h)    usage ;;
  *)            echo "Error: unknown command '$cmd'"; usage ;;
esac
