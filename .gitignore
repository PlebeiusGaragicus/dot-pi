.DS_Store
.env
.tavily.env
.tts-wpm
model_roles
shared/models.json
shared/settings.json
bin/
.ssh

# Agent runtime data
agents/*/sessions/*
!agents/*/sessions/.gitkeep
agents/*/auth.json
# agents/*/settings.json
agents/*/.cache/
subagents/*/sessions/*
!subagents/*/sessions/.gitkeep
subagents/*/auth.json
subagents/*/.cache/

# Eval results (generated per-run, can be large)
evals/results/

# Workspace team output (research artifacts are ephemeral)
workspaces/*
!workspaces/README.md

# Downloaded binaries (fd, rg) -- shared across teams via symlinks
shared/bin/*
!shared/bin/.gitkeep

# Typecheck node_modules (devDeps for extension type-checking)
tests/node_modules/

REFERENCES/*
IGNORE/