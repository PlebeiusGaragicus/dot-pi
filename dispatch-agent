#!/usr/bin/env bash
set -euo pipefail

# BusyBox-style dispatcher: behavior determined by $0 (the symlink name).
# All agent symlinks in bin/ point here.

AGENT_NAME="$(basename "$0")"
_pi_args=()

# ── env bootstrap ─────────────────────────────────────────────────────────────
# When invoked outside a shell that sourced env.sh (e.g. cron, scripts),
# bootstrap DOT_PI_DIR from our own location.

if [ -z "${DOT_PI_DIR:-}" ]; then
  DOT_PI_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
  [ -f "$DOT_PI_DIR/env.sh" ] && source "$DOT_PI_DIR/env.sh"
fi

# ── helpers ───────────────────────────────────────────────────────────────────

_has_flag() {
  local flag="$1"; shift
  for arg in "$@"; do [ "$arg" = "$flag" ] && return 0; done
  return 1
}

_pi() {
  PI_SKIP_VERSION_CHECK=1 PI_OFFLINE=1 command pi "$@"
}

_expand_env_vars() {
  local s="$1" out="" var name
  while [[ "$s" =~ \$\{?([A-Za-z_][A-Za-z0-9_]*)\}? ]]; do
    name="${BASH_REMATCH[1]}"
    var="${BASH_REMATCH[0]}"
    out+="${s%%"$var"*}${!name-}"
    s="${s#*"$var"}"
  done
  printf '%s' "$out$s"
}

_load_model_env() {
  local config_dir="$1"
  local file line name value fallback
  for file in "$config_dir/.model" "$DOT_PI_DIR/model-defaults"; do
    [ -f "$file" ] || continue
    while IFS= read -r line || [ -n "$line" ]; do
      [[ "$line" =~ ^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]] || continue
      name="${BASH_REMATCH[1]}"
      value="${BASH_REMATCH[2]}"
      fallback="${value#\"\$\{${name}:-}"
      if [ "$fallback" != "$value" ]; then
        fallback="${fallback%\}\"}"
        value="$fallback"
      else
        value="${value%\"}"
        value="${value#\"}"
      fi
      [ -n "${!name:-}" ] || export "$name=$value"
    done < "$file"
  done
}

_filter_model_flags() {
  local explicit_model=false explicit_thinking=false out=() arg next
  _has_flag "--model" "$@" && explicit_model=true
  _has_flag "--thinking" "$@" && explicit_thinking=true
  while [ ${#_pi_args[@]} -gt 0 ]; do
    arg="${_pi_args[0]}"
    _pi_args=("${_pi_args[@]:1}")
    case "$arg" in
      --model|--thinking)
        next="${_pi_args[0]:-}"
        [ ${#_pi_args[@]} -gt 0 ] && _pi_args=("${_pi_args[@]:1}")
        [ -z "$next" ] && continue
        [[ "$next" == --* ]] && { _pi_args=("$next" "${_pi_args[@]}"); continue; }
        [ "$arg" = "--model" ] && [ "$explicit_model" = true ] && continue
        [ "$arg" = "--thinking" ] && [ "$explicit_thinking" = true ] && continue
        out+=("$arg" "$next")
        ;;
      *)
        out+=("$arg")
        ;;
    esac
  done
  if [ ${#out[@]} -gt 0 ]; then
    _pi_args=("${out[@]}")
  else
    _pi_args=()
  fi
}

_load_pi_args() {
  local config_dir="$1" _line
  _pi_args=()
  _load_model_env "$config_dir"
  if [ -f "$config_dir/pi-args" ]; then
    while IFS= read -r _line || [ -n "$_line" ]; do
      [[ -z "$_line" || "$_line" == \#* ]] && continue
      _line="$(_expand_env_vars "$_line")"
      # shellcheck disable=SC2206  # intentional word-splitting so multi-word flags expand
      _pi_args+=($_line)
    done < "$config_dir/pi-args"
  fi
}

_slugify_workspace_name() {
  local name="$*"
  name=$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')
  name=$(printf '%s' "$name" | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')
  [ -n "$name" ] && printf '%s' "$name" || printf 'workspace'
}

_workspace_label() {
  local agent="$1" path="$2" base files ts title
  base=$(basename "$path")
  ts="${base%%--*}"
  if [[ "$base" == *"--"* ]]; then
    title="${base#*--}"
    title="${title//-/ }"
  else
    title=""
  fi
  files=$(find "$path" -maxdepth 2 -type f 2>/dev/null | wc -l | tr -d ' ')
  if [ -n "$title" ]; then
    printf '%-18s  %-15s  %-36s  (%s files)' "$agent" "$ts" "$title" "$files"
  else
    printf '%-18s  %-15s  %-36s  (%s files)' "$agent" "$ts" "-" "$files"
  fi
}

_resume_workspace_path() {
  local ws_path="$1"
  shift
  ws_path="${ws_path%/}"
  local agent config_dir
  agent=$(basename "$(dirname "$ws_path")")
  config_dir="$DOT_PI_DIR/agents/$agent"
  [ -d "$config_dir" ] || { echo "No agent config for workspace: $agent" >&2; return 1; }
  _load_pi_args "$config_dir"
  _filter_model_flags "$@"
  echo "Resuming: $ws_path" >&2
  local _resume_args=()
  [ -d "$ws_path/sessions" ] && _resume_args+=(--session-dir "$ws_path/sessions")
  local cmd_args=()
  [ ${#_pi_args[@]} -gt 0 ] && cmd_args+=("${_pi_args[@]}")
  [ ${#_resume_args[@]} -gt 0 ] && cmd_args+=("${_resume_args[@]}")
  cmd_args+=(--resume "$@")
  (cd "$ws_path" && PI_CODING_AGENT_DIR="$config_dir" _pi "${cmd_args[@]}")
}

_pick_workspace() {
  local title="$1"
  shift
  local paths=("$@")
  if [ ${#paths[@]} -eq 0 ]; then
    echo "No workspaces found" >&2
    return 1
  fi
  echo "$title" >&2
  local i=1 path agent
  for path in "${paths[@]}"; do
    agent=$(basename "$(dirname "${path%/}")")
    printf '%2d) %s\n' "$i" "$(_workspace_label "$agent" "$path")" >&2
    i=$((i + 1))
  done
  local reply
  while true; do
    printf 'Number: ' >&2
    IFS= read -r reply || return 1
    case "$reply" in
      ''|*[!0-9]*)
        echo "Invalid choice; enter a number." >&2
        ;;
      *)
        if [ "$reply" -ge 1 ] && [ "$reply" -le ${#paths[@]} ]; then
          printf '%s\n' "${paths[$((reply - 1))]}"
          return 0
        fi
        echo "Invalid choice; enter 1-${#paths[@]}." >&2
        ;;
    esac
  done
}

_collect_workspaces() {
  local limit="${1:-10}" query="${2:-}" d agent base haystack count=0
  shopt -s nullglob
  for d in "$DOT_PI_DIR"/workspaces/*/*/; do
    [ -d "$d" ] || continue
    agent=$(basename "$(dirname "${d%/}")")
    [ -f "$DOT_PI_DIR/agents/$agent/workspace.conf" ] || continue
    base=$(basename "${d%/}")
    haystack=$(printf '%s %s %s' "$agent" "$base" "${base//-/ }" | tr '[:upper:]' '[:lower:]')
    if [ -n "$query" ] && [[ "$haystack" != *"$(printf '%s' "$query" | tr '[:upper:]' '[:lower:]')"* ]]; then
      continue
    fi
    printf '%s\t%s\n' "$(stat -f '%m' "$d" 2>/dev/null || stat -c '%Y' "$d" 2>/dev/null || echo 0)" "${d%/}"
  done | sort -rn | while IFS=$'\t' read -r _mtime d; do
    [ -n "$d" ] || continue
    printf '%s\n' "$d"
    count=$((count + 1))
    [ "$count" -ge "$limit" ] && break
  done
}

# JSON event stream filter for batch mode.
# Progress lines -> stderr, final assistant text -> stdout.
_json_filter() {
  local turn=0 final_text=""
  while IFS= read -r line; do
    local type
    type=$(printf '%s' "$line" | jq -r '.type // empty' 2>/dev/null) || continue
    case "$type" in
      turn_start)
        turn=$((turn + 1))
        ;;
      tool_execution_start)
        local tool_name
        tool_name=$(printf '%s' "$line" | jq -r '.toolName // "?"')
        printf '[turn %d] tool: %s\n' "$turn" "$tool_name" >&2
        ;;
      tool_execution_end)
        local tool_name is_err
        tool_name=$(printf '%s' "$line" | jq -r '.toolName // "?"')
        is_err=$(printf '%s' "$line" | jq -r '.isError // false')
        if [ "$is_err" = "true" ]; then
          printf '[turn %d] tool: %s ERROR\n' "$turn" "$tool_name" >&2
        fi
        ;;
      message_end)
        local role text
        role=$(printf '%s' "$line" | jq -r '.message.role // empty')
        if [ "$role" = "assistant" ]; then
          text=$(printf '%s' "$line" | jq -r '
            [.message.content[]? | select(.type == "text") | .text]
            | join("\n")' 2>/dev/null)
          [ -n "$text" ] && final_text="$text"
        fi
        ;;
      agent_end)
        printf '[agent done]\n' >&2
        ;;
    esac
  done
  [ -n "$final_text" ] && printf '%s\n' "$final_text"
}

# ── help ──────────────────────────────────────────────────────────────────────

_show_help() {
  local config_dir="$1"
  local readme="$config_dir/README.md"
  if [ -f "$readme" ]; then
    if command -v glow &>/dev/null; then
      glow -p "$readme"
    elif command -v bat &>/dev/null; then
      bat --style=plain --paging=never "$readme"
    else
      cat "$readme"
    fi
  else
    echo "No README.md for $AGENT_NAME"
    echo "  config: $config_dir"
  fi
  exit 0
}

# ── workspace launcher ────────────────────────────────────────────────────────

_workspace_launch() {
  local name="$1" config_dir="$2"
  shift 2
  local ws_root="$DOT_PI_DIR/workspaces/$name"

  if [ "${1:-}" = "--list" ]; then
    if [ ! -d "$ws_root" ] || [ -z "$(ls -A "$ws_root" 2>/dev/null)" ]; then
      echo "No workspaces for $name"
      return 0
    fi
    echo "Workspaces for $name:"
    for d in "$ws_root"/*/; do
      [ -d "$d" ] || continue
      local ts files
      ts=$(basename "$d")
      files=$(find "$d" -maxdepth 2 -type f 2>/dev/null | wc -l | tr -d ' ')
      echo "  $ts  ($files files)"
    done
    return 0
  fi

  if [ "${1:-}" = "--resume" ]; then
    shift
    local target
    if [ -n "${1:-}" ]; then
      target=$(ls -d "$ws_root"/"$1"* 2>/dev/null | tail -1)
      if [ -z "$target" ]; then
        echo "No workspace matching '$1' in $ws_root"
        return 1
      fi
      shift
    else
      target=$(ls -dt "$ws_root"/*/ 2>/dev/null | head -1)
      if [ -z "$target" ]; then
        echo "No workspaces to resume for $name"
        return 1
      fi
    fi
    _resume_workspace_path "$target" "$@"
    return $?
  fi

  local pi_args=() workspace_name="" arg slug ws
  while [ $# -gt 0 ]; do
    arg="$1"
    shift
    if [ "$arg" = "-" ]; then
      workspace_name="$*"
      break
    fi
    pi_args+=("$arg")
  done

  ws="$ws_root/$(date +%Y-%m-%d-%H%M%S)"
  if [ -n "$workspace_name" ]; then
    slug="$(_slugify_workspace_name "$workspace_name")"
    ws="$ws--$slug"
  fi
  mkdir -p "$ws"
  while IFS= read -r subdir || [ -n "$subdir" ]; do
    [[ -n "$subdir" && "$subdir" != \#* ]] && mkdir -p "$ws/$subdir"
  done < "$config_dir/workspace.conf"
  echo "Workspace: $ws" >&2
  local _launch_args=()
  [ -d "$ws/sessions" ] && _launch_args+=(--session-dir "$ws/sessions")
  _filter_model_flags "${pi_args[@]}"
  local cmd_args=()
  [ ${#_pi_args[@]} -gt 0 ] && cmd_args+=("${_pi_args[@]}")
  [ ${#_launch_args[@]} -gt 0 ] && cmd_args+=("${_launch_args[@]}")
  [ ${#pi_args[@]} -gt 0 ] && cmd_args+=("${pi_args[@]}")
  (cd "$ws" && PI_CODING_AGENT_DIR="$config_dir" _pi "${cmd_args[@]}")
  return $?
}

_resume_global() {
  local query="$*"
  local paths=() selected
  while IFS= read -r selected; do
    [ -n "$selected" ] && paths+=("$selected")
  done < <(_collect_workspaces 10 "$query")
  if [ ${#paths[@]} -eq 0 ]; then
    if [ -n "$query" ]; then
      echo "No workspaces matching '$query'" >&2
    else
      echo "No workspaces found" >&2
    fi
    return 1
  fi
  selected=$(_pick_workspace "Recent workspaces:" "${paths[@]}") || return $?
  _resume_workspace_path "$selected"
}

# ── run-retro (special case) ──────────────────────────────────────────────────

_run_retro() {
  local ws_path="" hint="" mas=""

  if [ "${1:-}" = "--workspace-path" ]; then
    [ -z "${2:-}" ] && { echo "Error: --workspace-path requires a path" >&2; return 1; }
    ws_path="$2"
    shift 2
    mas=$(basename "$(dirname "$ws_path")")
    if [ "${1:-}" = "--" ]; then shift; hint="$*"; fi
  else
    mas="${1:?Usage: run-retro <mas> [--list|--pick] [date-prefix] [-- hint]}"
    shift
    local ws_root="$DOT_PI_DIR/workspaces/$mas"

    if [ "${1:-}" = "--list" ]; then
      if [ ! -d "$ws_root" ] || [ -z "$(ls -A "$ws_root" 2>/dev/null)" ]; then
        echo "No workspaces for $mas"
        return 0
      fi
      echo "Workspaces for $mas:"
      for d in "$ws_root"/*/; do
        [ -d "$d" ] || continue
        local ts files has_retro=""
        ts=$(basename "$d")
        files=$(find "$d" -maxdepth 2 -type f 2>/dev/null | wc -l | tr -d ' ')
        [ -f "$d/retrospective-report.md" ] && has_retro="  [retro]"
        echo "  $ts  ($files files)$has_retro"
      done
      return 0
    fi

    if [ "${1:-}" = "--pick" ]; then
      shift
      local pick_paths=() pick_labels=() _d
      while IFS= read -r _d; do
        [ -z "$_d" ] && continue
        _d="${_d%/}"
        [ ! -d "$_d" ] && continue
        pick_paths+=("$_d")
        local _ts _files _hr=""
        _ts=$(basename "$_d")
        _files=$(find "$_d" -maxdepth 2 -type f 2>/dev/null | wc -l | tr -d ' ')
        [ -f "$_d/retrospective-report.md" ] && _hr=" [retro]"
        pick_labels+=("$_ts  ($_files files)$_hr")
      done < <(ls -dt "$ws_root"/*/ 2>/dev/null)
      if [ ${#pick_paths[@]} -eq 0 ]; then
        echo "No workspaces for $mas" >&2
        return 1
      fi
      echo "Select a workspace for $mas:"
      local PS3="Number: " _choice
      select _choice in "${pick_labels[@]}" "Cancel"; do
        if [ "$_choice" = "Cancel" ]; then echo "Cancelled." >&2; return 1; fi
        if [ -z "$_choice" ]; then echo "Invalid choice; try again." >&2; continue; fi
        local _idx=$((REPLY - 1))
        if [ "$_idx" -ge 0 ] && [ "$_idx" -lt ${#pick_paths[@]} ]; then
          ws_path="${pick_paths[$_idx]}"
          break
        fi
        echo "Invalid choice; try again." >&2
      done
    elif [ -n "${1:-}" ] && [ "$1" != "--" ]; then
      ws_path=$(ls -d "$ws_root/$1"* 2>/dev/null | tail -1)
      [ -z "$ws_path" ] && { echo "No workspace matching '$1' in $ws_root" >&2; return 1; }
      shift
    else
      ws_path=$(ls -dt "$ws_root"/*/ 2>/dev/null | head -1)
      [ -z "$ws_path" ] && { echo "No workspaces for $mas" >&2; return 1; }
    fi

    if [ "${1:-}" = "--" ]; then shift; hint="$*"; fi
  fi

  [ ! -d "$ws_path" ] && { echo "Error: workspace not found: $ws_path" >&2; return 1; }

  local source_system="$DOT_PI_DIR/agents/$mas/SYSTEM.md"
  if [ -f "$source_system" ] && [ ! -e "$ws_path/.source-orchestrator-system.md" ]; then
    ln -s "$source_system" "$ws_path/.source-orchestrator-system.md"
  fi

  local prompt="Analyze this $mas MAS workspace."
  [ -n "$hint" ] && prompt="$prompt Focus: $hint"

  local retro_dir="$DOT_PI_DIR/agents/retro"
  local retro_sessions="$retro_dir/sessions"
  mkdir -p "$retro_sessions"
  echo "Retro: $ws_path" >&2
  (cd "$ws_path" && PI_CODING_AGENT_DIR="$retro_dir" pi --mode json \
    --session-dir "$retro_sessions" -p "$prompt" < /dev/null) | _json_filter
  return ${PIPESTATUS[0]:-${pipestatus[1]:-$?}}
}

# ── list available agents ─────────────────────────────────────────────────────

_list_available() {
  echo "Available agents:" >&2
  printf '  %-20s  %-8s  %s\n' "name" "kind" "mode" >&2
  {
    for d in "$DOT_PI_DIR"/agents/*/; do
      [ -d "$d" ] || continue
      local name mode kind
      name=$(basename "$d")
      mode=$([ -f "$d/workspace.conf" ] && echo workspace || echo in-situ)
      kind=$([ -e "$d/extensions/agent-orchestrator/index.ts" ] && echo mas || echo agent)
      printf '%s\t%s\t%s\n' "$name" "$kind" "$mode"
    done
  } | sort -t $'\t' -k1,1 | while IFS=$'\t' read -r name kind mode; do
    printf '  %-20s  %-8s  %s\n' "$name" "$kind" "$mode" >&2
  done
}

# ── main ──────────────────────────────────────────────────────────────────────

# Special dispatch: run-retro
if [ "$AGENT_NAME" = "run-retro" ]; then
  _run_retro "$@"
  exit $?
fi

# Special dispatch: resume
if [ "$AGENT_NAME" = "resume" ]; then
  _resume_global "$@"
  exit $?
fi

# Special dispatch: dispatch-agent invoked directly (not via symlink)
if [ "$AGENT_NAME" = "dispatch-agent" ]; then
  echo "Usage: invoke via an agent symlink (e.g. lm, recon, blog)" >&2
  echo ""
  _list_available
  exit 1
fi

# Resolve config directory
config_dir=""
if [ -d "$DOT_PI_DIR/agents/$AGENT_NAME" ]; then
  config_dir="$DOT_PI_DIR/agents/$AGENT_NAME"
else
  echo "Unknown agent: $AGENT_NAME" >&2
  _list_available
  exit 1
fi

# Help flag
if _has_flag "-h" "$@" || _has_flag "--help" "$@"; then
  _show_help "$config_dir"
fi

# ── batch mode ────────────────────────────────────────────────────────────────
# Activated when stdin is a pipe OR -p is passed explicitly.
# Precedence: explicit -p wins; piped stdin is only consumed when no -p flag
# is present. In batch mode we add --mode json so pi emits a JSON event stream,
# which _json_filter reduces to human-friendly stderr + final text on stdout.
_batch=false
_workspace_meta=false
if [ -f "$config_dir/workspace.conf" ]; then
  case "${1:-}" in
    --list|--resume) _workspace_meta=true ;;
  esac
fi
if [ "$_workspace_meta" = false ] && { [ ! -t 0 ] || _has_flag "-p" "$@"; }; then
  _batch=true
fi

if [ "$_workspace_meta" = false ] && [ ! -t 0 ] && ! _has_flag "-p" "$@"; then
  _stdin_prompt=$(cat)
  set -- -p "$_stdin_prompt" "$@"
fi

if [ "$_batch" = true ]; then
  set -- --mode json "$@"
fi

# Load default CLI flags from pi-args
_load_pi_args "$config_dir"
if [ ! -f "$config_dir/workspace.conf" ]; then
  _filter_model_flags "$@"
  if [ ${#_pi_args[@]} -gt 0 ]; then
    set -- "${_pi_args[@]}" "$@"
  fi
fi

# Dispatch: workspace or in-situ
if [ -f "$config_dir/workspace.conf" ]; then
  if [ "$_batch" = true ]; then
    _workspace_launch "$AGENT_NAME" "$config_dir" "$@" | _json_filter
    exit ${PIPESTATUS[0]:-${pipestatus[1]:-$?}}
  else
    _workspace_launch "$AGENT_NAME" "$config_dir" "$@"
    exit $?
  fi
else
  if [ "$_batch" = true ]; then
    PI_CODING_AGENT_DIR="$config_dir" _pi "$@" | _json_filter
    exit ${PIPESTATUS[0]:-${pipestatus[1]:-$?}}
  else
    PI_CODING_AGENT_DIR="$config_dir" _pi "$@"
    exit $?
  fi
fi
