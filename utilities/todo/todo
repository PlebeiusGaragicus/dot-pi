#!/usr/bin/env bash
set -euo pipefail

command -v jq >/dev/null 2>&1 || {
	echo "todo: jq is required" >&2
	exit 1
}

todo_script_dir() {
	local src="${BASH_SOURCE[0]}"
	local dir
	while [[ -L "$src" ]]; do
		dir="$(cd -P "$(dirname "$src")" && pwd)"
		src="$(readlink "$src")"
		[[ "$src" != /* ]] && src="$dir/$src"
	done
	cd -P "$(dirname "$src")" && pwd
}

TODO_SCRIPT_DIR="$(todo_script_dir)"
VERSION_FILE="$TODO_SCRIPT_DIR/VERSION"

TODO_FILE=""

resolve_todo_file() {
	local dir="$PWD"
	while true; do
		if [[ -f "$dir/todo.jsonl" ]]; then
			TODO_FILE="$dir/todo.jsonl"
			return 0
		fi
		if [[ "$dir" == "/" ]]; then
			mkdir -p "$HOME/.todo"
			TODO_FILE="$HOME/.todo/todo.jsonl"
			[[ -f "$TODO_FILE" ]] || : >"$TODO_FILE"
			return 0
		fi
		dir="$(dirname "$dir")"
	done
}

usage() {
	cat <<'EOF'
usage:
  todo                    show usage
  todo list               list open (not done) tasks as markdown
  todo done               list finished tasks as markdown
  todo all                list all tasks as markdown (open and finished)
  todo new "foo"          add a task
  todo edit <id> "bar"    edit a task's text
  todo del <id>           delete a task
  todo finish <id>        mark task finished
  todo unfinish <id>      mark task not finished
  todo file               create todo.jsonl in the current directory
  todo which              print path to active todo.jsonl
  todo rm [-y|--yes]      delete active todo.jsonl (prompts unless -y/--yes)
  todo help               show this help
  todo version            print version
EOF
}

validate_id() {
	local id="$1"
	if [[ ! "$id" =~ ^[0-9]+$ ]]; then
		echo "todo: invalid id (expected non-negative integer): $id" >&2
		exit 1
	fi
}

id_exists() {
	local id="$1"
	[[ -s "$TODO_FILE" ]] || return 1
	jq -es --argjson id "$id" 'any(.[]; .id == $id)' "$TODO_FILE" >/dev/null
}

write_jsonl() {
	local tmp
	tmp="$(mktemp)"
	if cat >"$tmp"; then
		mv "$tmp" "$TODO_FILE"
	else
		rm -f "$tmp"
		return 1
	fi
}

abs_path() {
	local f="$1"
	printf '%s\n' "$(cd "$(dirname "$f")" && pwd)/$(basename "$f")"
}

cmd_file() {
	local target="$PWD/todo.jsonl"
	if [[ -e "$target" ]]; then
		echo "todo: todo.jsonl already exists here: $(abs_path "$target")" >&2
		exit 1
	fi
	: >"$target"
	printf 'created %s\n' "$(abs_path "$target")"
}

cmd_which() {
	resolve_todo_file
	abs_path "$TODO_FILE"
}

cmd_rm() {
	local force=false
	while [[ $# -gt 0 ]]; do
		case "$1" in
		-y | --yes)
			force=true
			shift
			;;
		*)
			echo 'todo: usage: todo rm [-y|--yes]' >&2
			exit 1
			;;
		esac
	done
	resolve_todo_file
	if [[ ! -f "$TODO_FILE" ]]; then
		echo "todo: no todo file to remove at $(abs_path "$TODO_FILE")" >&2
		exit 1
	fi
	local path
	path="$(abs_path "$TODO_FILE")"
	if ! $force; then
		local ans
		if ! read -r -p "Delete ${path}? [y/N] " ans </dev/tty; then
			echo "todo: cannot prompt (not a tty); use todo rm --yes" >&2
			exit 1
		fi
		ans=$(printf '%s' "$ans" | tr '[:upper:]' '[:lower:]')
		if [[ "$ans" != "y" && "$ans" != "yes" ]]; then
			echo "todo: cancelled" >&2
			exit 1
		fi
	fi
	rm -- "$TODO_FILE"
	printf 'removed %s\n' "$path"
}

cmd_list() {
	resolve_todo_file
	[[ ! -s "$TODO_FILE" ]] && return 0
	jq -r 'select(.done != true) | "- [ ] (\(.id)) \(.text)"' "$TODO_FILE"
}

cmd_all() {
	resolve_todo_file
	[[ ! -s "$TODO_FILE" ]] && return 0
	jq -r 'if .done then "- [x] (\(.id)) \(.text)" else "- [ ] (\(.id)) \(.text)" end' "$TODO_FILE"
}

cmd_done_list() {
	resolve_todo_file
	[[ ! -s "$TODO_FILE" ]] && return 0
	jq -r 'select(.done == true) | "- [x] (\(.id)) \(.text)"' "$TODO_FILE"
}

cmd_new() {
	local text="$*"
	if [[ -z "$text" ]]; then
		echo 'todo: new requires non-empty text' >&2
		exit 1
	fi
	resolve_todo_file
	local next_id
	if [[ ! -s "$TODO_FILE" ]]; then
		next_id=0
	else
		next_id="$(jq -s 'map(.id) | max // -1 | . + 1' "$TODO_FILE")"
	fi
	jq -nc --arg text "$text" --argjson id "$next_id" '{id: $id, text: $text, done: false}' >>"$TODO_FILE"
}

cmd_edit() {
	local id="$1"
	shift
	local text="$*"
	validate_id "$id"
	if [[ -z "$text" ]]; then
		echo 'todo: edit requires new text' >&2
		exit 1
	fi
	resolve_todo_file
	if ! id_exists "$id"; then
		echo "todo: no task with id $id" >&2
		exit 1
	fi
	jq -s --argjson id "$id" --arg text "$text" 'map(if .id == $id then .text = $text else . end) | .[] | .' -c "$TODO_FILE" | write_jsonl
}

cmd_del() {
	local id="$1"
	validate_id "$id"
	resolve_todo_file
	if ! id_exists "$id"; then
		echo "todo: no task with id $id" >&2
		exit 1
	fi
	jq -s --argjson id "$id" 'map(select(.id != $id)) | .[] | .' -c "$TODO_FILE" | write_jsonl
}

cmd_finish() {
	local id="$1"
	validate_id "$id"
	resolve_todo_file
	if ! id_exists "$id"; then
		echo "todo: no task with id $id" >&2
		exit 1
	fi
	jq -s --argjson id "$id" 'map(if .id == $id then .done = true else . end) | .[] | .' -c "$TODO_FILE" | write_jsonl
}

cmd_unfinish() {
	local id="$1"
	validate_id "$id"
	resolve_todo_file
	if ! id_exists "$id"; then
		echo "todo: no task with id $id" >&2
		exit 1
	fi
	jq -s --argjson id "$id" 'map(if .id == $id then .done = false else . end) | .[] | .' -c "$TODO_FILE" | write_jsonl
}

cmd_version() {
	if [[ -f "$VERSION_FILE" ]]; then
		tr -d '\n' <"$VERSION_FILE"
		printf '\n'
	else
		echo "todo: VERSION file missing in $TODO_SCRIPT_DIR" >&2
		exit 1
	fi
}

main() {
	case "${1:-}" in
	"" | -h | --help | help)
		usage
		;;
	file)
		cmd_file
		;;
	which)
		cmd_which
		;;
	rm)
		shift
		cmd_rm "$@"
		;;
	list)
		cmd_list
		;;
	all)
		cmd_all
		;;
	done)
		if [[ $# -ne 1 ]]; then
			echo 'todo: usage: todo done' >&2
			exit 1
		fi
		cmd_done_list
		;;
	new)
		shift
		cmd_new "$@"
		;;
	edit)
		[[ $# -ge 3 ]] || {
			echo 'todo: usage: todo edit <id> "new text"' >&2
			exit 1
		}
		id="$2"
		shift 2
		cmd_edit "$id" "$@"
		;;
	del)
		[[ $# -eq 2 ]] || {
			echo 'todo: usage: todo del <id>' >&2
			exit 1
		}
		cmd_del "$2"
		;;
	finish)
		[[ $# -eq 2 ]] || {
			echo 'todo: usage: todo finish <id>' >&2
			exit 1
		}
		cmd_finish "$2"
		;;
	unfinish)
		[[ $# -eq 2 ]] || {
			echo 'todo: usage: todo unfinish <id>' >&2
			exit 1
		}
		cmd_unfinish "$2"
		;;
	version | --version | -v)
		cmd_version
		;;
	*)
		echo "todo: unknown command: $1" >&2
		usage >&2
		exit 1
		;;
	esac
}

main "$@"
