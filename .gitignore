.DS_Store
model-defaults
shared/models.json
shared/settings.json
shared/auth.json
.env
# Overlay API keys and prefs (under $DOT_PI_OVERLAY; visible names)
env.exa
env.tavily
env.ntfy
env.tts-wpm
env.ssh
# Broad ignores for mistaken secret paths at repo root (not read by dot-pi)
.*.env
.tts-wpm
.ssh
.browser-control/
core/bin/
google.json
todo.jsonl

package-lock.json

# Agent runtime data
agents/*/sessions/*
!agents/*/sessions/.gitkeep
agents/*/auth.json
agents/*/env.model
agents/*/agents/*/env.model
agents/*/.cache/
agents/*-beta/

# Eval results (generated per-run, can be large)
evals/results/

# Workspace output (research artifacts are ephemeral)
agents/*/workspaces/

# Downloaded binaries (fd, rg) -- shared across MAS configs via symlinks
shared/bin/*
!shared/bin/.gitkeep

# MkDocs build output (local)
site/

# Typecheck node_modules (devDeps for extension type-checking)
core/tests/node_modules/
core/utilities/browser-runtime/node_modules/
core/utilities/browser-runtime/dist/

REFERENCES/*
IGNORE/