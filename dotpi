#!/usr/bin/env bash
set -euo pipefail

DOT_PI_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
COMMANDS_DIR="$DOT_PI_DIR/core/commands"

source "$COMMANDS_DIR/_common.sh"

usage() {
  cat <<EOF
dotpi — dot-pi management CLI

Usage: dotpi <command> [args]

Commands:
  setup                                    Interactive setup wizard (API keys and models)
  model-defaults                           Configure local fallback model aliases
  list                                     List existing agent configs
  link-skill <agent> <skill> [...]         Symlink one or more shared skills into an agent config
  link-auth <src> <dst>                    Override auth.json symlink (src: agent name, file path, or "shared")
  relink                                   Rebuild local symlinks and overlay resource links
  symlink-agents [--dry-run] [--rc FILE]   Add core/bin to PATH in shell rc (zsh: ~/.zshrc; bash: ~/.bashrc on Linux/macOS)
  version | --version | -v                 Print dotpi version (from VERSION file) and exit

Examples:
  dotpi setup
  dotpi model-defaults
  dotpi list
  dotpi link-skill my-agent searxng
  dotpi link-auth shared blog             # point blog at shared/auth.json
  dotpi relink                            # rerun postinstall-style local wiring
  dotpi symlink-agents                    # add agent commands to PATH in shell rc
EOF
  exit 1
}

[ $# -lt 1 ] && usage

cmd="$1"
shift

case "$cmd" in
  setup)        source "$COMMANDS_DIR/setup.sh" "$@" ;;
  model-defaults)
                source "$COMMANDS_DIR/model-defaults.sh" "$@" ;;
  list)         source "$COMMANDS_DIR/list.sh" "$@" ;;
  link-skill)   source "$COMMANDS_DIR/link-skill.sh" "$@" ;;
  link-auth)    source "$COMMANDS_DIR/link-auth.sh" "$@" ;;
  relink)       source "$COMMANDS_DIR/relink.sh" "$@" ;;
  symlink-agents)
                source "$COMMANDS_DIR/symlink-agents.sh" "$@" ;;
  version|--version|-v)
                v="unknown"
                [ -f "$DOT_PI_DIR/VERSION" ] && v="$(cat "$DOT_PI_DIR/VERSION")"
                echo "dotpi $v"
                exit 0 ;;
  --help|-h)    usage ;;
  *)            echo "Error: unknown command '$cmd'"; usage ;;
esac
