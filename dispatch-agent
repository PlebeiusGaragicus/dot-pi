#!/usr/bin/env bash
set -euo pipefail

# BusyBox-style dispatcher: behavior determined by $0 (the symlink name).
# All agent symlinks in bin/ point here.

# shellcheck disable=SC2034  # used by sourced dispatch modules
AGENT_NAME="$(basename "$0")"

# DOT_PI_DIR is a runtime contract for every pi process launched by dot-pi.
# Self-locate here so users only need core/bin on PATH; child processes inherit
# this value through dispatch/runtime setup and normal process inheritance.
if [ -z "${DOT_PI_DIR:-}" ]; then
  DOT_PI_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || realpath "$0" 2>/dev/null || echo "$0")")" && pwd)"
fi
export DOT_PI_DIR

_dispatch_source() {
  local module="$DOT_PI_DIR/core/dispatch/$1"
  if [ ! -f "$module" ]; then
    echo "Missing dispatch module: $module" >&2
    exit 1
  fi
  # shellcheck source=/dev/null
  source "$module"
}

_dispatch_source runtime.sh
_dispatch_source util.sh
_dispatch_source invoke.sh
_dispatch_source pi-args.sh
_dispatch_source bootstrap.sh
_dispatch_source help.sh
_dispatch_source cli.sh
_dispatch_source workspace.sh
_dispatch_source main.sh

_dispatch_main "$@"
