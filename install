#!/usr/bin/env bash
set -euo pipefail

REPO_URL="https://github.com/PlebeiusGaragicus/dot-pi.git"
DOT_PI_HOME="${DOT_PI_HOME:-$HOME/.dot-pi}"
FORCE_REBASE=false

# ── helpers ───────────────────────────────────────────────────────────────────

bold()  { printf '\033[1m%s\033[0m' "$*"; }
green() { printf '\033[32m%s\033[0m' "$*"; }
yellow(){ printf '\033[33m%s\033[0m' "$*"; }
red()   { printf '\033[31m%s\033[0m' "$*"; }

info()  { echo "  $(green "✓") $*"; }
warn()  { echo "  $(yellow "!") $*"; }
fail()  { echo "  $(red "✗") $*"; exit 1; }

confirm() {
  local prompt="$1" default="${2:-Y}"
  local yn
  if [ "$default" = "Y" ]; then
    read -r -p "  $prompt [Y/n] " yn
    [[ "${yn:-Y}" =~ ^[Yy]$ ]]
  else
    read -r -p "  $prompt [y/N] " yn
    [[ "${yn:-N}" =~ ^[Yy]$ ]]
  fi
}

shell_rc() {
  local sh
  sh="$(basename "${SHELL:-/bin/bash}")"
  case "$sh" in
    zsh)  echo "$HOME/.zshrc" ;;
    bash) echo "$HOME/.bashrc" ;;
    *)    echo "$HOME/.${sh}rc" ;;
  esac
}

usage() {
  cat <<EOF
dot-pi installer

Usage:
  install                   Install dot-pi to $DOT_PI_HOME
  install --force-rebase    Update an existing install (stash, rebase, pop)
  install --uninstall       Remove dot-pi and clean up shell config
  install --help            Show this help

Environment:
  DOT_PI_HOME   Override install location (default: ~/.dot-pi)

One-liner:
  bash -c "\$(curl -fsSL https://raw.githubusercontent.com/PlebeiusGaragicus/dot-pi/main/install)"
EOF
  exit 0
}

# ── dependency checks ─────────────────────────────────────────────────────────

check_deps() {
  local missing=()
  for cmd in git curl jq; do
    command -v "$cmd" &>/dev/null || missing+=("$cmd")
  done
  if [ ${#missing[@]} -gt 0 ]; then
    echo ""
    red "  Missing required tools: ${missing[*]}"; echo ""
    echo ""
    echo "  Install them first:"
    if [[ "$OSTYPE" == darwin* ]]; then
      echo "    brew install ${missing[*]}"
    else
      echo "    sudo apt install ${missing[*]}   # Debian/Ubuntu"
      echo "    sudo dnf install ${missing[*]}   # Fedora"
    fi
    exit 1
  fi
}

check_pi() {
  if command -v pi &>/dev/null; then
    info "pi found: $(command -v pi)"
  else
    warn "pi (coding agent) not found on PATH"
    echo "    Install it with: npm install -g @mariozechner/pi-coding-agent"
  fi
}

# ── install ───────────────────────────────────────────────────────────────────

do_install() {
  echo ""
  echo "  $(bold "dot-pi installer")"
  echo "  ════════════════"
  echo ""
  echo "  Install location: $(bold "$DOT_PI_HOME")"
  echo ""

  check_deps
  check_pi
  echo ""

  # Clone, update, or bail
  if [ -d "$DOT_PI_HOME/.git" ]; then
    if [ "$FORCE_REBASE" = true ]; then
      info "Updating dot-pi (rebase)..."
      local stashed=false
      if ! git -C "$DOT_PI_HOME" diff --quiet 2>/dev/null || \
         ! git -C "$DOT_PI_HOME" diff --cached --quiet 2>/dev/null; then
        git -C "$DOT_PI_HOME" stash push -m "dotpi-installer-autostash"
        stashed=true
      fi
      git -C "$DOT_PI_HOME" pull --rebase || {
        warn "Rebase failed — resolve conflicts in $DOT_PI_HOME and run: git rebase --continue"
        [ "$stashed" = true ] && warn "Your local changes are stashed. Run: git stash pop"
        exit 1
      }
      if [ "$stashed" = true ]; then
        git -C "$DOT_PI_HOME" stash pop || {
          warn "Stash pop had conflicts — resolve them in $DOT_PI_HOME"
        }
      fi
      info "Updated successfully"
    else
      echo ""
      info "dot-pi is already installed at $(bold "$DOT_PI_HOME")"
      echo ""
      local rc
      rc="$(shell_rc)"
      if ! grep -qF "dot-pi" "$rc" 2>/dev/null; then
        warn "Shell not configured yet. Add the following to $(bold "$rc"):"
        echo ""
        echo "$(green '# dot-pi — pi agent launcher')"
        echo "$(green "export PATH=\"\$HOME/.dot-pi/bin:\$PATH\"")"
        echo "$(green "source \"\$HOME/.dot-pi/env.sh\"")"
        echo ""
      fi
      echo "    To update:      $DOT_PI_HOME/install --force-rebase"
      echo "    To reconfigure: $DOT_PI_HOME/dotpi setup"
      echo "    To remove:      $DOT_PI_HOME/install --uninstall"
      echo ""
      exit 0
    fi
  elif [ -d "$DOT_PI_HOME" ]; then
    fail "$DOT_PI_HOME exists but is not a git repo. Remove it first or set DOT_PI_HOME."
  else
    info "Cloning dot-pi..."
    git clone "$REPO_URL" "$DOT_PI_HOME"
  fi
  echo ""

  # Shell RC integration
  local rc
  rc="$(shell_rc)"

  # Build bin/ symlinks
  "$DOT_PI_HOME/dotpi" sync
  echo ""

  echo "  $(bold "Done!")"
  echo ""

  if grep -qF "dot-pi" "$rc" 2>/dev/null; then
    info "Shell already configured — restart your shell or run: source $rc"
  else
    echo "  Add the following to $(bold "$rc"):"
    echo ""
    echo "  $(green '# dot-pi — pi agent launcher')"
    echo "  $(green "export PATH=\"\$HOME/.dot-pi/bin:\$PATH\"")"
    echo "  $(green "source \"\$HOME/.dot-pi/env.sh\"")"
    echo ""
    echo "  Then run $(bold "dotpi setup") to configure your API key and models."
  fi
  echo ""
}

# ── uninstall ─────────────────────────────────────────────────────────────────

do_uninstall() {
  echo ""
  echo "  $(bold "dot-pi uninstaller")"
  echo "  ══════════════════"
  echo ""

  if [ ! -d "$DOT_PI_HOME" ]; then
    warn "dot-pi not found at $DOT_PI_HOME — nothing to remove"
    exit 0
  fi

  echo "  This will remove: $(bold "$DOT_PI_HOME")"
  echo ""

  if ! confirm "Are you sure?" "N"; then
    echo "  Cancelled."
    exit 0
  fi
  echo ""

  # Remove source line from shell RC
  local rc
  rc="$(shell_rc)"

  rm -rf "$DOT_PI_HOME"
  info "Removed $DOT_PI_HOME"
  echo ""

  echo ""
  echo "  $(bold "dot-pi has been removed.")"
  echo ""
  if [ -f "$rc" ] && grep -qF "dot-pi" "$rc" 2>/dev/null; then
    echo "  Remove these lines from $(bold "$rc"):"
    echo ""
    grep -n "dot-pi" "$rc" | while IFS= read -r line; do
      echo "    $line"
    done
    echo ""
  fi
  echo "  Restart your shell to complete cleanup."
  echo ""
}

# ── main ──────────────────────────────────────────────────────────────────────

case "${1:-}" in
  --force-rebase) FORCE_REBASE=true; do_install ;;
  --uninstall)    do_uninstall ;;
  --help|-h)      usage ;;
  "")             do_install ;;
  *)              echo "Unknown option: $1"; usage ;;
esac
